# ==========================================
# Завдання 1: Рекурсивне обчислення суми цифр числа
# ==========================================
def sum_of_digits(number: int) -> int:
    """
    Рекурсивно обчислює суму цифр цілого числа.
    """
    # Перетворюємо число на додатне, якщо воно від'ємне
    number = abs(number)
    
    # Базовий випадок: якщо число одноцифрове, повертаємо його
    if number < 10:
        return number
        
    # Рекурсивний крок: остання цифра (number % 10) + сума цифр решти числа (number // 10)
    return (number % 10) + sum_of_digits(number // 10)


# ==========================================
# Завдання 2: Обчислення степеня числа
# ==========================================
def power(base: float, exponent: int) -> float:
    """
    Рекурсивно обчислює n-ий степінь числа x (base у степені exponent).
    """
    # Базовий випадок: будь-яке число в нульовому степені дорівнює 1
    if exponent == 0:
        return 1.0
        
    # Обробка від'ємного степеня
    if exponent < 0:
        return 1 / power(base, -exponent)
        
    # Рекурсивний крок: base * base^(exponent - 1)
    return base * power(base, exponent - 1)


