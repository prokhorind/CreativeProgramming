# Завдання 2. Функція з параметрами
# ==========================================
def greet_student(name):
    """Виводить персональне привітання для учня."""
    print(f"Привіт, {name}! Радий бачити тебе на уроці.")

def show_task(subject, task):
    """Виводить назву предмета та завдання."""
    print(f"Предмет: {subject} | Завдання: {task}")

# Викликаємо функцію привітання для трьох різних імен
print("--- Завдання 2 (Привітання) ---")
greet_student("Олена")
greet_student("Максим")
greet_student("Антон")
print()

# Викликаємо функцію показу завдання для двох різних предметів
print("--- Завдання 2 (Предмети) ---")
show_task("Інформатика", "Створення функцій у Python")
show_task("Алгебра", "Розв'язання квадратних рівнянь")
print()


# ==========================================
# Завдання 3. Функція з параметрами та return
# ==========================================
def calculate_total(price, quantity):
    """Обчислює та повертає загальну вартість покупки."""
    return price * quantity

def show_receipt(total_amount):
    """Виводить суму до сплати."""
    print(f"Сума до сплати: {total_amount} грн.")

print("--- Завдання 3 (Покупки) ---")
# 1. Перша покупка (ціна 35 грн, кількість 4)
total = calculate_total(35, 4)
show_receipt(total)

# 2. Друга покупка (інша: ціна 50 грн, кількість 3)
second_purchase_total = calculate_total(50, 3)
show_receipt(second_purchase_total)

# 3. Обчислення вартості першої покупки зі знижкою 10%
discount = total * 0.10
total_with_discount = total - discount
print(f"Сума першої покупки зі знижкою 10%: {total_with_discount} грн.")
