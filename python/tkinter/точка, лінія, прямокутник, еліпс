import tkinter as tk

# Створення головного вікна
root = tk.Tk()
root.title("Space Rocket")
root.geometry("600x450")
root.resizable(False, False)

# Створення полотна (Canvas) з темним фоном космосу
canvas = tk.Canvas(root, width=600, height=450, bg="#0b001a")
canvas.pack(fill="both", expand=True)

# 1. Зірки на фоні (маленькі білі овали)
canvas.create_oval(100, 80, 106, 86, fill="white", outline="white")
canvas.create_oval(250, 50, 254, 54, fill="white", outline="white")
canvas.create_oval(450, 100, 456, 106, fill="white", outline="white")
canvas.create_oval(520, 200, 524, 204, fill="white", outline="white")
canvas.create_oval(80, 250, 85, 255, fill="white", outline="white")
canvas.create_oval(180, 350, 185, 355, fill="white", outline="white")

# 2. Планета вдалині (жовто-оранжевий еліпс)
canvas.create_oval(420, 40, 520, 140, fill="#ffb703", outline="#fb8500", width=2)

# 3. Полум'я двигуна (помаранчеві та жовті трикутники)
canvas.create_polygon(275, 380, 300, 440, 325, 380, fill="#ff5400", outline="#ffb703")
canvas.create_polygon(285, 380, 300, 415, 315, 380, fill="#ffb703", outline="")

# 4. Корпус ракети (прямокутник)
canvas.create_rectangle(260, 180, 340, 380, fill="#e5e5e5", outline="#333333", width=2)

# 5. Нос ракети (червоний трикутник)
canvas.create_polygon(260, 180, 340, 180, 300, 100, fill="#d90429", outline="#333333", width=2)

# 6. Ілюмінатор / вікно (блакитне коло)
canvas.create_oval(285, 220, 315, 250, fill="#00b4d8", outline="#03045e", width=3)

# 7. Ліве крило ракети
canvas.create_polygon(260, 300, 220, 380, 260, 380, fill="#d90429", outline="#333333", width=2)

# 8. Праве крило ракети
canvas.create_polygon(340, 300, 380, 380, 340, 380, fill="#d90429", outline="#333333", width=2)

# Запуск головного циклу програми
root.mainloop()
